diff --git a/app/Database/Migrations/2026-10-25-100000_AddCodigoToProducto.php b/app/Database/Migrations/2026-10-25-100000_AddCodigoToProducto.php
new file mode 100644
index 0000000..e91e83c
--- /dev/null
+++ b/app/Database/Migrations/2026-10-25-100000_AddCodigoToProducto.php
@@ -0,0 +1,87 @@
+<?php
+
+namespace App\Database\Migrations;
+
+use App\Libraries\CodigoProducto;
+use CodeIgniter\Database\Migration;
+
+/**
+ * Código único de producto (requerimiento #8).
+ *
+ * Agrega producto.codigo (VARCHAR 30) con un índice UNIQUE y rellena los productos que ya
+ * existen, en orden de id, con el mismo generador que usa el alta (App\Libraries\CodigoProducto):
+ * categoría + nombre, y consecutivo -02, -03... si dos productos generan el mismo código.
+ *
+ * La columna admite NULL a propósito: así un producto cargado por fuera de la app (por
+ * ejemplo con un INSERT directo) no rompe nada; la app siempre le pone código a los nuevos.
+ *
+ * Es idempotente: si la columna o el índice ya existen, no los vuelve a crear, y solo
+ * rellena los productos que siguen sin código.
+ */
+class AddCodigoToProducto extends Migration
+{
+    private const INDICE = 'uq_producto_codigo';
+
+    public function up()
+    {
+        if (! $this->db->fieldExists('codigo', 'producto')) {
+            $this->forge->addColumn('producto', [
+                'codigo' => [
+                    'type'       => 'VARCHAR',
+                    'constraint' => 30,
+                    'null'       => true,
+                    'default'    => null,
+                ],
+            ]);
+        }
+
+        $this->rellenarExistentes();
+
+        if (! $this->existeIndice()) {
+            $this->db->query('ALTER TABLE `producto` ADD UNIQUE KEY `' . self::INDICE . '` (`codigo`)');
+        }
+    }
+
+    public function down()
+    {
+        if ($this->existeIndice()) {
+            $this->db->query('ALTER TABLE `producto` DROP INDEX `' . self::INDICE . '`');
+        }
+
+        if ($this->db->fieldExists('codigo', 'producto')) {
+            $this->forge->dropColumn('producto', 'codigo');
+        }
+    }
+
+    /** Asigna código a los productos que no tienen, respetando los que ya lo tienen. */
+    private function rellenarExistentes(): void
+    {
+        $usados = array_map(
+            'strtoupper',
+            array_column($this->db->query('SELECT codigo FROM producto WHERE codigo IS NOT NULL')->getResultArray(), 'codigo')
+        );
+
+        $pendientes = $this->db
+            ->query('SELECT id, nombre, categoria FROM producto WHERE codigo IS NULL ORDER BY id ASC')
+            ->getResultArray();
+
+        foreach ($pendientes as $p) {
+            $base   = CodigoProducto::base((string) $p['categoria'], (string) $p['nombre']);
+            $codigo = CodigoProducto::siguienteLibre($base, $usados);
+
+            $usados[] = $codigo;
+
+            $this->db->query('UPDATE producto SET codigo = ? WHERE id = ?', [$codigo, (int) $p['id']]);
+        }
+    }
+
+    private function existeIndice(): bool
+    {
+        $filas = $this->db->query(
+            'SHOW INDEX FROM `producto` WHERE Key_name = ?',
+            [self::INDICE]
+        )->getResultArray();
+
+        return $filas !== [];
+    }
+}
diff --git a/app/Libraries/CodigoProducto.php b/app/Libraries/CodigoProducto.php
new file mode 100644
index 0000000..8f3646f
--- /dev/null
+++ b/app/Libraries/CodigoProducto.php
@@ -0,0 +1,89 @@
+<?php
+
+namespace App\Libraries;
+
+/**
+ * Generador de códigos únicos de producto (requerimiento #8).
+ *
+ * Formato:  CAT-NOMBRE        ->  FRU-UVAAZU
+ *           CAT-NOMBRE-NN     ->  FRU-UVAAZU-02   (cuando el código base ya existe)
+ *
+ *  - CAT    : 3 letras fijas por categoría (frutas=FRU, verduras=VER, hierbas=HIE;
+ *             sin categoría = GEN).
+ *  - NOMBRE : 3 letras de la 1.ª palabra + 3 de la 2.ª ("uva azul" -> UVAAZU,
+ *             "uva morada" -> UVAMOR). Con una sola palabra, hasta 6 letras
+ *             ("zanahoria" -> ZANAHO). Se ignoran "de", "la", "con", etc.
+ *  - NN     : consecutivo que se agrega SOLO si dos productos distintos generan el
+ *             mismo código base (p. ej. "uva azul" y "uva azulada").
+ *
+ * Esta clase no toca la base de datos: solo calcula texto. Quien la usa (el modelo o la
+ * migración) le dice qué códigos ya existen. La garantía final de unicidad es el índice
+ * UNIQUE de la columna producto.codigo.
+ */
+class CodigoProducto
+{
+    public const PREFIJOS = [
+        'frutas'   => 'FRU',
+        'verduras' => 'VER',
+        'hierbas'  => 'HIE',
+    ];
+
+    public const PREFIJO_GENERICO = 'GEN';
+
+    private const PALABRAS_IGNORADAS = ['DE', 'DEL', 'LA', 'EL', 'LOS', 'LAS', 'Y', 'CON', 'EN', 'A'];
+
+    private const SIN_ACENTOS = [
+        'Á' => 'A', 'É' => 'E', 'Í' => 'I', 'Ó' => 'O', 'Ú' => 'U', 'Ü' => 'U', 'Ñ' => 'N',
+        'á' => 'A', 'é' => 'E', 'í' => 'I', 'ó' => 'O', 'ú' => 'U', 'ü' => 'U', 'ñ' => 'N',
+    ];
+
+    /** Código base (sin consecutivo) a partir de la categoría y el nombre. */
+    public static function base(string $categoria, string $nombre): string
+    {
+        $prefijo = self::PREFIJOS[strtolower(trim($categoria))] ?? self::PREFIJO_GENERICO;
+
+        return $prefijo . '-' . self::abreviarNombre($nombre);
+    }
+
+    /**
+     * Primer código libre a partir del base: BASE, BASE-02, BASE-03...
+     *
+     * @param list<string> $existentes Códigos que ya están en uso (los que empiezan con $base).
+     */
+    public static function siguienteLibre(string $base, array $existentes): string
+    {
+        $usados = array_flip(array_map('strtoupper', $existentes));
+
+        if (! isset($usados[$base])) {
+            return $base;
+        }
+
+        $n = 2;
+        while (isset($usados[sprintf('%s-%02d', $base, $n)])) {
+            $n++;
+        }
+
+        return sprintf('%s-%02d', $base, $n);
+    }
+
+    private static function abreviarNombre(string $nombre): string
+    {
+        $texto = strtr($nombre, self::SIN_ACENTOS);
+        $texto = strtoupper(preg_replace('/[^A-Za-z0-9 ]+/', ' ', $texto) ?? '');
+
+        $palabras = array_values(array_filter(
+            preg_split('/\s+/', trim($texto)) ?: [],
+            static fn (string $p): bool => $p !== '' && ! in_array($p, self::PALABRAS_IGNORADAS, true)
+        ));
+
+        if ($palabras === []) {
+            return 'PROD';
+        }
+
+        if (count($palabras) === 1) {
+            return substr($palabras[0], 0, 6);
+        }
+
+        return substr($palabras[0], 0, 3) . substr($palabras[1], 0, 3);
+    }
+}
