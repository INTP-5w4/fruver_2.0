diff --git a/database_cambios/codigo_producto_cambios.sql b/database_cambios/codigo_producto_cambios.sql
new file mode 100644
index 0000000..ea4a57f
--- /dev/null
+++ b/database_cambios/codigo_producto_cambios.sql
@@ -0,0 +1,25 @@
+-- ============================================================
+-- FRUVER 2.0 · Código único de producto (requerimiento #8)
+-- Alternativa a la migración 2026-10-25-100000_AddCodigoToProducto.
+-- Si ya corriste `php spark migrate`, NO hace falta ejecutar este archivo.
+--
+-- OJO: este archivo solo crea la columna y el índice. Los productos que ya existen
+-- se rellenan con la migración (php spark migrate), porque el código sale de la
+-- categoría + el nombre y se calcula en PHP. Si usas solo phpMyAdmin, ejecuta este
+-- archivo y luego `php spark migrate` una vez para rellenar los códigos pendientes
+-- (la migración no vuelve a crear lo que ya existe).
+--
+-- Usa ADD COLUMN IF NOT EXISTS (MariaDB, que es la que trae XAMPP). En MySQL 8 quita
+-- las palabras "IF NOT EXISTS" y no repitas el ADD UNIQUE KEY si ya lo creaste.
+-- ============================================================
+
+ALTER TABLE `producto`
+  ADD COLUMN IF NOT EXISTS `codigo` VARCHAR(30) NULL DEFAULT NULL;
+
+-- El índice UNIQUE es la garantía final de que no haya dos productos con el mismo código.
+-- Si algún código ya estuviera repetido, este paso falla: corrige el duplicado y repite.
+ALTER TABLE `producto`
+  ADD UNIQUE KEY `uq_producto_codigo` (`codigo`);
+
+-- Formato:  CAT-NOMBRE  (FRU-UVAAZU)  o  CAT-NOMBRE-NN  (FRU-UVAAZU-02) si ya existe.
+--   CAT: frutas=FRU, verduras=VER, hierbas=HIE, sin categoría=GEN
diff --git a/tests/unit/CodigoProductoTest.php b/tests/unit/CodigoProductoTest.php
new file mode 100644
index 0000000..c0775d5
--- /dev/null
+++ b/tests/unit/CodigoProductoTest.php
@@ -0,0 +1,59 @@
+<?php
+
+use App\Libraries\CodigoProducto;
+use CodeIgniter\Test\CIUnitTestCase;
+
+/**
+ * @internal
+ */
+final class CodigoProductoTest extends CIUnitTestCase
+{
+    public function testUvaAzulYUvaMoradaTienenCodigosDistintos(): void
+    {
+        $this->assertSame('FRU-UVAAZU', CodigoProducto::base('frutas', 'Uva azul'));
+        $this->assertSame('FRU-UVAMOR', CodigoProducto::base('frutas', 'uva morada'));
+    }
+
+    public function testUnaSolaPalabraUsaHastaSeisLetras(): void
+    {
+        $this->assertSame('VER-ZANAHO', CodigoProducto::base('verduras', 'Zanahoria'));
+        $this->assertSame('FRU-KIWI', CodigoProducto::base('frutas', 'kiwi'));
+    }
+
+    public function testIgnoraArticulosAcentosYSimbolos(): void
+    {
+        $this->assertSame('VER-FLOCAL', CodigoProducto::base('verduras', 'Flor de calabaza'));
+        $this->assertSame('FRU-PLAMAC', CodigoProducto::base('frutas', 'Plátano Macho'));
+        $this->assertSame('HIE-EPAZOT', CodigoProducto::base('hierbas', 'Epazote'));
+        $this->assertSame('VER-CHAYOT', CodigoProducto::base('verduras', 'Chayóte!!'));
+    }
+
+    public function testCategoriaVaciaOInvalidaUsaGEN(): void
+    {
+        $this->assertSame('GEN-PERA', CodigoProducto::base('', 'pera'));
+        $this->assertSame('GEN-PERA', CodigoProducto::base('otra', 'pera'));
+    }
+
+    public function testNombreSinLetrasUsaPROD(): void
+    {
+        $this->assertSame('FRU-PROD', CodigoProducto::base('frutas', '***'));
+    }
+
+    public function testSiguienteLibreAgregaConsecutivo(): void
+    {
+        $this->assertSame('FRU-UVAAZU', CodigoProducto::siguienteLibre('FRU-UVAAZU', []));
+        $this->assertSame('FRU-UVAAZU-02', CodigoProducto::siguienteLibre('FRU-UVAAZU', ['FRU-UVAAZU']));
+        $this->assertSame(
+            'FRU-UVAAZU-03',
+            CodigoProducto::siguienteLibre('FRU-UVAAZU', ['FRU-UVAAZU', 'FRU-UVAAZU-02'])
+        );
+    }
+
+    public function testSiguienteLibreRellenaHuecosYNoEsSensibleAMayusculas(): void
+    {
+        $this->assertSame(
+            'FRU-UVAAZU-02',
+            CodigoProducto::siguienteLibre('FRU-UVAAZU', ['fru-uvaazu', 'FRU-UVAAZU-03'])
+        );
+    }
+}
